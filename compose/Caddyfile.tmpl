{
    email __ACME_EMAIL__
    default_sni __VPS_HOST__
    admin :2019

    servers {
        metrics
    }

    order replace after encode
}

(authelia_required) {
    forward_auth authelia:9091 {
        uri /api/verify?rd=https://__VPS_HOST__/login
        # Pin the verify sub-request to GET. By default Caddy forwards the
        # original method (and body) to /api/verify, which causes Authelia
        # 4.38 to treat non-GET requests inconsistently — researcher POSTs
        # to /flash/api/firmware reach upstream and return the backend's 405
        # instead of Authelia's 403. Audit finding 1.6.
        method GET
        header_up X-Forwarded-Method {method}
        header_up X-Forwarded-Uri {uri}
        # Strip the original Content-Length so Authelia doesn't try to read
        # a body off the GET we just pinned above.
        header_up Content-Length ""
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email

        # Authelia returns 403 (raw "Forbidden" body) for authenticated users
        # who lack the required role. Without this hook, forward_auth proxies
        # that response unchanged. Converting it to an internal Caddy error
        # routes it through handle_errors below → /_errors/403.
        @forbidden status 403
        handle_response @forbidden {
            error 403
        }
    }
}

# Navbar injection — used both in the main route and inside handle_errors so
# error pages get the rail too. Defined as a snippet because the directives
# inside `handle_errors {…}` form their own subroute; a server-level `replace`
# outside it doesn't apply to error responses.
(inject_navbar) {
    replace {
        match {
            header Content-Type *text/html*
        }
        "</head>" `<script src="/_shared/navbar.js?v=__PLATFORM_VERSION__" data-version="__PLATFORM_VERSION__" data-disabled="__DISABLED_NAV__" defer></script></head>`
    }
}

https://__VPS_HOST__ {
    tls {
        issuer acme {
            profile shortlived
        }
    }

    # ─── Global security headers (audit finding 5.1) ─────────────────────
    # SETs and the -Server delete are split into two `header` directives
    # on purpose: Caddy auto-defers the ENTIRE handler if any op inside it
    # is a delete (-) or replace. A deferred SET runs after the response is
    # produced, so it silently overrides any per-handle CSP override. Keep
    # SETs in their own block (immediate) so subroute SETs win — see the
    # /jupyter handle below.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Content-Security-Policy   "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'"
    }
    header -Server

    # ─── Platform shell assets ───────────────────────────────────────────
    handle /_shared/* {
        uri strip_prefix /_shared
        root * /srv/shell
        file_server {
            precompressed gzip
        }
        header Cache-Control "public, max-age=60, must-revalidate"
    }

    # ─── Authelia (public — OIDC discovery + redirects) ──────────────────
    # `uri strip_prefix /auth` is load-bearing: Authelia 4.38 mounts every
    # route (OIDC endpoints, /api/firstfactor, /.well-known/*) at the root.
    # Without the strip, /auth/api/oidc/authorization falls through to the
    # Authelia React SPA catch-all, which returns 200 with a portal HTML
    # page whose <base href> doesn't match the /auth/ sub-path — Grafana
    # never receives the OIDC redirect and the handshake silently breaks.
    handle /auth/* {
        uri strip_prefix /auth
        reverse_proxy authelia:9091 {
            header_up -Accept-Encoding
        }
    }

    # ─── siteapp public routes (unchanged) ───────────────────────────────
    handle /_static/* {
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
    }
    handle /docs* {
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
    }
    handle /download* {
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
    }
    handle /api/agent/upload {
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
    }
    handle /api/public* {
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
    }

    # ─── siteapp auth surface (login form, API, error pages) ─────────────
    handle /login {
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
    }
    handle /logout {
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
    }
    handle /api/auth/* {
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
    }

    # ─── siteapp admin surface (admins only — forward_auth gate) ─────────
    # Reachability for the SerialHop remote-update proxy
    # (POST/GET /api/admin/labs/{name}/update[/status]). Gated exactly like
    # /flash: forward_auth pins the verify sub-request to GET, so a researcher
    # POST resolves to 403 while an admin POST proceeds with its body intact.
    handle /api/admin/* {
        import authelia_required
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
    }

    # --- BEGIN svc:flasher ---
    # ─── Flasher (admins only — forward_auth replaces basic_auth) ────────
    handle /flash/api/v1/* {
        reverse_proxy flasher:8000 {
            header_up -Accept-Encoding
        }
    }
    handle /flash* {
        import authelia_required
        reverse_proxy flasher:8000 {
            header_up -Accept-Encoding
        }
    }
    # --- END svc:flasher ---

    # --- BEGIN svc:streamer ---
    # ─── Streamer — WHIP (public, bearer-token auth) + viewer UI ─────────
    # WHIP endpoints carry their own bearer-token auth (tokens.py); they must
    # NOT go through Authelia or the CORS preflight + non-GET methods break.
    handle /streamer/whip/* {
        reverse_proxy streamer:8000 {
            header_up -Accept-Encoding
        }
    }

    # Everything else under /streamer/* is Authelia-gated (researchers + admins).
    handle /streamer/* {
        import authelia_required
        import inject_navbar
        reverse_proxy streamer:8000 {
            header_up -Accept-Encoding
        }
    }
    # --- END svc:streamer ---

    # --- BEGIN svc:studio ---
    # ─── Experiment Studio (researchers + admins) ────────────────────────
    # External image (lab-devices repo). SPA + API served at container root;
    # the app emits relative URLs (>= 0.3.0), so strip the public prefix.
    # The exact-path redirect is load-bearing: the SPA resolves relative
    # URLs against the document URL, so it must be loaded at /studio/
    # (trailing slash), never /studio. reverse_proxy passes the run-events
    # WebSocket upgrade through automatically; no extra directive needed.
    redir /studio /studio/ 308
    handle /studio/* {
        import authelia_required
        import inject_navbar
        # The route wrapper is load-bearing: Caddy sorts a handle's directives
        # by its global directive order, which runs `uri` BEFORE forward_auth —
        # Authelia would then see the stripped path ("/"), match no rule, and
        # default-deny everyone. `route` preserves written order: authenticate
        # against the un-stripped /studio path first, then strip for upstream.
        route {
            uri strip_prefix /studio
            reverse_proxy studio:8000 {
                header_up -Accept-Encoding
            }
        }
    }
    # --- END svc:studio ---

    # --- BEGIN svc:monitoring ---
    # ─── Grafana (forward_auth gate in front of Grafana's OIDC) ──────────
    # forward_auth gives anonymous users our custom /login form instead of
    # Authelia's broken-under-sub-path React portal. Once they have an
    # authelia_session, Grafana's OIDC flow completes silently behind the
    # scenes and Grafana maps Authelia groups → Grafana roles.
    # /grafana/api/health stays public — scripts/deploy.sh polls it during
    # the post-deploy health check, and Grafana's own readiness probes
    # would otherwise be redirected to /login.
    handle /grafana/api/health {
        reverse_proxy grafana:3000 {
            header_up -Accept-Encoding
        }
    }
    handle /grafana/* {
        import authelia_required
        header Content-Security-Policy "(script-src[^;]*)" "${1} 'self'"
        header Content-Security-Policy "(style-src[^;]*)" "${1} 'self'"
        reverse_proxy grafana:3000 {
            header_up -Accept-Encoding
        }
    }
    # --- END svc:monitoring ---

    # --- BEGIN svc:jupyter ---
    # ─── JupyterLab (forward_auth replaces shared password) ──────────────
    # JupyterLab needs 'unsafe-eval' in script-src: codemirror mode loading,
    # mathjax, ajv settings validation, and plugin bootstrap all run code
    # via `new Function()`. Without it the Lab UI loads its asset bundles
    # but can't instantiate any plugin and renders a blank Main panel. SET
    # (rather than a regex replace) is what overrides the global CSP — and
    # only works because the global header block is split so its SETs aren't
    # auto-deferred (see the comment above the global block).
    handle /jupyter* {
        import authelia_required
        header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'"
        reverse_proxy jupyter:8888 {
            header_up -Accept-Encoding
        }
    }
    # --- END svc:jupyter ---

    # --- BEGIN svc:jupyter ---
    # ─── Temporary redirect for old Jupyter bookmarks ────────────────────
    @old_jupyter {
        path /lab* /tree*
    }
    redir @old_jupyter /jupyter{uri} 302
    # --- END svc:jupyter ---

    # ─── Home — siteapp serves / ─────────────────────────────────────────
    handle / {
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
    }

    # ─── Catch-all → 404 via handle_errors ───────────────────────────────
    # Without this, paths that match none of the handle directives above
    # fall through to Caddy's default behavior (empty 200 response). The
    # `error 404` directive emits a 404 status, which triggers the
    # handle_errors block below to render the styled /_errors/404 page.
    handle {
        error 404
    }

    # ─── Global HTML rewrite — navbar injection ──────────────────────────
    import inject_navbar

    # ─── Error pages → siteapp templates ─────────────────────────────────
    handle_errors {
        @e403 expression {http.error.status_code} == 403
        @e404 expression {http.error.status_code} == 404
        @e401 expression {http.error.status_code} == 401
        # Thread the original request path through as ?path= so siteapp's
        # 403/404 templates can display what the user actually tried to reach.
        # Using {http.request.orig_uri.path} (not orig_uri) intentionally drops
        # the query string — a raw URI would get spliced after ?path= and
        # confuse the query-string parser. Special chars in the path are not
        # re-encoded; malformed paths from non-browser clients may display
        # truncated in the meta block.
        rewrite @e403 /_errors/403?path={http.request.orig_uri.path}
        rewrite @e404 /_errors/404?path={http.request.orig_uri.path}
        # 401 from forward_auth is already turned into a 302 to /login by the
        # snippet's rd= parameter. If we still see a 401 here, treat it as a
        # 403 so the user sees a useful page instead of Caddy's raw error.
        rewrite @e401 /_errors/403?path={http.request.orig_uri.path}
        reverse_proxy siteapp:8000 {
            header_up -Accept-Encoding
        }
        # handle_errors forms its own subroute; the main route's replace
        # does not apply here. Inject the navbar inside the error subroute.
        import inject_navbar
    }
}
