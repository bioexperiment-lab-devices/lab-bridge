# CI-only config template. Rendered by .github/workflows/release-please.yml
# on the runner via `envsubst`. Schema mirrors the post-refactor config.yaml
# (instance values + password hashes + roster only). Stack pins come from
# compose/pins.yaml (paths/ports/retention) and compose/images.yaml
# (externally-released image tags), read by scripts/lib/config.sh.
#
# DO NOT use this template for laptop deploys — `task deploy` uses your
# gitignored config.yaml.

# vps_public_ip is omitted on purpose. config.sh falls back to .vps.host
# when this field is absent, which is the correct value for a CI deploy
# that ships to the real VPS (the deploy target IS the public-facing
# address). A previous hardcoded `127.0.0.1` here was a bug — it left
# STREAMER_PUBLIC_IP pointing at loopback in production, so WebRTC ICE
# candidates and the WHIP URL handed to SerialHop all resolved to
# 127.0.0.1, breaking the entire media plane.

vps:
  host: ${VPS_HOST}
  ssh_user: ${VPS_SSH_USER}

jupyter:
  password_hash: "${JUPYTER_PASSWORD_HASH}"

siteapp:
  admin_password_hash: "${ADMIN_PASSWORD_HASH}"

# Roster lives on the operator's laptop and on the VPS. CI deploys are
# roster-preserving (scripts/deploy.sh with LDS_STACK_ONLY=1 excludes
# chisel/users.json and siteapp/clients.json from rsync). LDS_REQUIRE_VAULT=1
# asserts this field stays empty in stack-only mode.
chisel_clients: []

# Optional-service selection for the CI-deployed VPS. Rendered from the
# LDS_DISABLED_SERVICES repo variable (comma-separated group names, e.g.
# "jupyter, monitoring"; empty = full stack). DUAL-MANAGED with the
# operator's laptop config.yaml, like the secret pairs above — if they
# drift, the next release re-enables (or removes) services on the VPS.
disabled_services: [${LDS_DISABLED_SERVICES}]
