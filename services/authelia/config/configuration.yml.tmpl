# Rendered at deploy time by scripts/lib/render.sh::render_authelia_config.
# Tokens substituted: __VPS_HOST__, __GRAFANA_OIDC_SECRET_HASH__.
# Secret material (JWT, session, storage encryption, OIDC HMAC, OIDC JWKS key)
# is injected via *_FILE env vars from docker secrets — see
# compose/docker-compose.yml.tmpl.

theme: light

server:
  # Replaces the deprecated server.host / server.port pair.
  address: tcp://0.0.0.0:9091/

log:
  level: info
  format: text

totp:
  issuer: lab-bridge

authentication_backend:
  password_reset:
    disable: true
  refresh_interval: 30s
  file:
    path: /config/users_database.yml
    password:
      algorithm: argon2id

access_control:
  default_policy: deny
  rules:
    - domain: __VPS_HOST__
      resources:
        - '^/api/auth/whoami$'
      policy: one_factor
    - domain: __VPS_HOST__
      resources:
        - '^/streamer/whip(/.*)?$'
      policy: bypass
    - domain: __VPS_HOST__
      resources:
        - '^/streamer($|/.*)'
      policy: one_factor
      subject:
        - 'group:researchers'
        - 'group:admins'
    - domain: __VPS_HOST__
      resources:
        - '^/studio($|/.*)'
      policy: one_factor
      subject:
        - 'group:researchers'
        - 'group:admins'
    - domain: __VPS_HOST__
      resources:
        - '^/flash.*'
      policy: one_factor
      subject: 'group:admins'
    - domain: __VPS_HOST__
      resources:
        - '^/api/admin/.*'
      policy: one_factor
      subject: 'group:admins'
    - domain: __VPS_HOST__
      resources:
        - '^/jupyter.*'
      policy: one_factor
      subject:
        - 'group:admins'
        - 'group:researchers'
    - domain: __VPS_HOST__
      resources:
        - '^/grafana/.*'
      policy: one_factor
      subject:
        - 'group:admins'
        - 'group:researchers'

session:
  # 4.38 multi-domain form. The flat `session.domain` / `name` / `expiration`
  # / `inactivity` / `remember_me_duration` keys still auto-map, but Authelia
  # warns that the mapping goes away in 5.0 — and `authelia_url` only exists
  # in this form.
  cookies:
    - domain: __VPS_HOST__
      # Authelia's own portal, as reached through Caddy's `uri strip_prefix
      # /auth` route. Note the host is an IP here: the new form is happy with
      # that as long as authelia_url sits on the same host, which rules out
      # the usual auth.<domain> subdomain layout.
      authelia_url: https://__VPS_HOST__/auth
      # Replaces the deprecated top-level `default_redirection_url`.
      default_redirection_url: https://__VPS_HOST__/
      name: authelia_session
      same_site: lax
      expiration: 1h
      inactivity: 5m
      remember_me: 2160h    # 90 days
  # Sessions live in Redis, not in Authelia's process memory. deploy.sh
  # restarts authelia on every full deploy (a single-file bind mount pins the
  # original inode, so a rsynced configuration.yml / users_database.yml stays
  # invisible until the process restarts) — and with the default in-memory
  # provider that restart silently destroyed every session, remembered ones
  # included. Note `expiration` and `inactivity` above apply only to sessions
  # where the user did NOT tick "keep me signed in": a remembered session
  # ignores both and lives for remember_me. Verified against 4.38.10;
  # spec: docs/superpowers/specs/2026-07-26-authelia-session-persistence-design.md
  redis:
    host: redis
    port: 6379

regulation:
  max_retries: 3
  find_time: 2m
  ban_time: 5m

storage:
  local:
    path: /data/db.sqlite3

notifier:
  disable_startup_check: true
  filesystem:
    filename: /data/notification.txt

identity_providers:
  oidc:
    # Replaces the deprecated `issuer_private_key`. This is a list, and
    # Authelia's env-var mapping cannot express list entries — so unlike the
    # other secrets this one is read here via the template filter
    # (X_AUTHELIA_CONFIG_FILTERS=template in compose). The key material still
    # comes from the docker secret and is never written into a rendered file.
    jwks:
      - key: |
          {{- secret "/run/secrets/authelia_oidc_jwks_key" | nindent 10 }}
    cors:
      endpoints:
        - authorization
        - token
        - revocation
        - introspection
        - userinfo
    clients:
      - client_id: grafana
        client_name: Grafana
        client_secret: '__GRAFANA_OIDC_SECRET_HASH__'
        public: false
        authorization_policy: one_factor
        # Skip the consent prompt: Authelia's React SPA is broken under our
        # /auth/ sub-path (its assets are absolute-pathed to /static/... and
        # /manifest.json with no prefix), and even if we routed /consent to
        # Authelia the page would load with broken JS. Grafana is a trusted
        # internal client, so implicit consent is appropriate. Without this,
        # the OIDC flow ends with Authelia 302→/consent, which falls through
        # Caddy's catch-all to 404 — the auth code never reaches Grafana and
        # no OIDC user is ever provisioned.
        consent_mode: implicit
        redirect_uris:
          - https://__VPS_HOST__/grafana/login/generic_oauth
        scopes:
          - openid
          - profile
          - email
          - groups
          # Required alongside the refresh_token grant below — Authelia warns
          # today and will reject the client outright in a future version.
          - offline_access
        grant_types:
          - authorization_code
          - refresh_token
        response_types:
          - code
        userinfo_signed_response_alg: none
